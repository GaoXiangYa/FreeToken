digraph R {
  graph [rankdir=LR, nodesep=0.18, ranksep=0.55, fontname="Noto Serif CJK SC", pad=0.12];
  node  [shape=box, style="rounded,filled", fontname="Noto Serif CJK SC", fontsize=8.8, color="#8fa3b8", fillcolor="#ffffff", penwidth=0.9, width=1.3];
  edge  [color="#8494a7", arrowsize=0.5, fontname="Noto Serif CJK SC", fontsize=8];

  n1  [fillcolor="#eef6fb", label="① POST\n/v1/chat/\ncompletions"]
  n2  [fillcolor="#eef6fb", label="② GenSpec\n协议中立\n请求"]
  n3  [fillcolor="#eef6fb", label="③ TokenizeMsg\n+ 立即建 SSE 流"]
  n4  [fillcolor="#eef8f0", label="④ worker\ntokenize\nchat template"]
  n5  [fillcolor="#eef8f0", label="⑤ UserMsg\ninput_ids"]
  n6  [fillcolor="#fdf8ec", label="⑥ 调度\nPendingReq\n→ PrefillAdder"]
  n7  [fillcolor="#fdf8ec", label="⑦ 组批\n页分配\npage_table"]
  n8  [fillcolor="#fdf8ec", label="⑧ forward\n图 replay\n+ 采样"]
  n9  [fillcolor="#fdf8ec", label="⑨ 排空\nEOS/stop\n提交前缀缓存"]
  n10 [fillcolor="#eef8f0", label="⑩ DetokenizeMsg\n增量解码\nUTF-8/stop 回退"]
  n11 [fillcolor="#eef6fb", label="⑪ UserReply\n唤醒 waiter"]
  n12 [fillcolor="#eef6fb", label="⑫ SSE chunk\n→ [DONE]"]

  n1 -> n2 -> n3
  n3 -> n4 [label=" ZMQ ft3"]
  n4 -> n5
  n5 -> n6 [label=" ZMQ ft0"]
  n6 -> n7 -> n8 -> n9
  n9 -> n10 [label=" ZMQ ft1"]
  n10 -> n11 [label=" ZMQ ft4"]
  n11 -> n12

  note [shape=note, fillcolor="#fff8e1", fontsize=8, label="跨 3 次进程边界；\n⑦⑧⑨ 在 overlap_loop 内\nCPU 与 GPU 交叠执行"]
  n7 -> note [style=dotted, arrowhead=none, color="#b5a36a"]
  {rank=same; n1; n2}
}
